# SMTP Configuration for GoDaddy / Office 365
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@arabiansamad.com
SMTP_PASS=your-office365-password-or-app-password
# Use SMTP_PASS_B64 in Hostinger if password contains special characters like '#' which get cut off as comments
# Encode password to base64 using terminal: echo -n "your#password" | base64
# SMTP_PASS_B64=eW91ciNwYXNzd29yZA==
CONTACT_RECIPIENT_EMAIL=info@arabiansamad.com

